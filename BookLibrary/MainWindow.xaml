<Window x:Class="BookLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Училищна библиотека" Height="560" Width="860"
        MinHeight="400" MinWidth="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <TabControl x:Name="Tabs">

            <!-- ===== КНИГИ ===== -->
            <TabItem Header="Книги">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Търсене по заглавие:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Width="280" Padding="3" TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="BooksGrid" Grid.Row="1" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MouseDoubleClick="EditBook_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Заглавие" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="220"/>
                            <DataGridTextColumn Header="Година" Binding="{Binding Year}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Добави" Click="AddBook_Click"/>
                        <Button Content="Редактирай" Click="EditBook_Click"/>
                        <Button Content="Изтрий" Click="DeleteBook_Click"/>
                        <Button Content="Търси в онлайн каталог (Open Library)" Click="Catalog_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== АВТОРИ ===== -->
            <TabItem Header="Автори">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AuthorsGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MouseDoubleClick="EditAuthor_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Име" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Държава" Binding="{Binding Country}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Добави" Click="AddAuthor_Click"/>
                        <Button Content="Редактирай" Click="EditAuthor_Click"/>
                        <Button Content="Изтрий" Click="DeleteAuthor_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
