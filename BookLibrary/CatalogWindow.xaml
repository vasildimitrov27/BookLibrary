<Window x:Class="BookLibrary.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Онлайн каталог – Open Library" Height="480" Width="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Търси" IsDefault="True"
                    Click="Search_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="QueryBox" Padding="3"/>
        </DockPanel>

        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" MouseDoubleClick="Use_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Заглавие" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200"/>
                <DataGridTextColumn Header="Година" Binding="{Binding Year}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray"
                   Text="Въведете заглавие или автор и натиснете „Търси“."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Използвай избраната" Click="Use_Click"/>
            <Button Content="Затвори" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
